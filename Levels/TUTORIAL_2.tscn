[node name="info_sign2" parent="." index="49" instance=ExtResource("10_g7dew")]
position = Vector2(784, 160)
message_text = "Your DASH (C or SHIFT) can be extended, giving you an additional speed boost alongside cancelling the end slowdown. It's tricky to perform, but after some practice you'll be zooming around the stages extremely fast! You need to press the JUMP button as soon as you LAND on the ground DURING A DASH. There's a nice practice spot to your left, good luck."
anim_hide_cooldown = 24.0
pause_duration = 0.0
start_hidden = true
start_hidden_show_cooldown = 60.0

[node name="info_sign3" parent="." index="50" instance=ExtResource("10_g7dew")]
