[node name="info_sign2" parent="." index="18" instance=ExtResource("8_qjbpv")]
position = Vector2(960, 32)
message_text = "Acquiring 3000 points with only 2 collectibles present might seem impossible, however when you become familiar with the various multiplier-based scoring mechanics, the fact that it isn't, will become second nature! For now, try collecting both collectibles in quick succession."
anim_hide_cooldown = 16.0
pause_duration = 10.0
