[node name="info_sign3" parent="." index="19" instance=ExtResource("8_qjbpv")]
position = Vector2(400, -288)
message_text = "The trick to ending up with 3000 points here, is to leave the bottom jewel uncollected, and go up to the second one, then quickly drop down on the first one! The blue puzzle object will allow you to retry this as many times as you need."
