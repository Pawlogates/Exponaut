[node name="info_sign" parent="." index="15" instance=ExtResource("8_mn2bl")]
position = Vector2(64, -1056)
message_text = "If you JUMP right after LANDING on the ground, you will extend your dash. You have to do it quickly after dashing though. Try dashing off and into the platform to your left, then pressing the JUMP key. It could take many tries ;) Hold the DOWN arrow if you can't manage it in time!"

[node name="info_sign2" parent="." index="16" instance=ExtResource("8_mn2bl")]
position = Vector2(-1504, -672)
message_text = "Hold the UP ARROW to climb :)"
start_hidden = true

[node name="info_sign3" parent="." index="17" instance=ExtResource("8_mn2bl")]
position = Vector2(1120, -416)
message_text = "Hold the UP ARROW AFTER wall jumping, to start CLIMBING up the wall!"
pause_duration = 2.0

[node name="info_sign4" parent="." index="18" instance=ExtResource("8_mn2bl")]
position = Vector2(864, -32)
message_text = "This stage is a great place for experimenting with your movement! Try to get a good feel for how the lil bro controls, and you might see your score improve drastically!"
start_hidden = true
start_hidden_show_cooldown = 45.0

[node name="info_sign5" parent="." index="19" instance=ExtResource("8_mn2bl")]
position = Vector2(1664, -1568)
message_text = "Press C or SHIFT to perform a dash! Bonus pro tip: holding SPACE will slow down your fall!"
pause_duration = 0.0

